{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "council/discovery-proposal.v1",
  "title": "Council R0 Discovery Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "justification"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "justification": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
